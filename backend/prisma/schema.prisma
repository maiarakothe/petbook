generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// Depois de você fazer qualquer alteração nesse arquivo executa: npx prisma generate

model Usuario {

  id String @id @default(uuid())
  nome String
  email String @unique
  senha String
  @@map("usuarios")

}

model Pet {

  id String @id @default(uuid())
  nome String
  raca String
  tipo_animal String
  idade Int
  localizacao String
  @@map("pets")
}

model Publicacao {

  id String @id @default(uuid())
  //foto
  legenda String
  @@map("publicacoes")
}