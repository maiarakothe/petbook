generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


// Depois de você fazer qualquer alteração nesse arquivo executa: npx prisma generate
//e: npx prisma migrate dev

model Usuario {

  id String @id @default(uuid())
  nome String
  email String @unique
  senha String

  pets Pet[]
  publicacoes Publicacao[]
  curtida Curtida[]

  @@map("usuarios")
}

model Pet {

  id String @id @default(uuid())
  nome String
  foto String
  raca String
  tipo_animal String
  idade String
  localizacao String

  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  publicacoes Publicacao[]

  @@map("pets")
}

model Publicacao {

  id String @id @default(uuid())
  foto String
  legenda String
  tipo TipoPublicacao

  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  petId String
  pet Pet @relation(fields: [petId], references: [id])

  curtida Curtida[]

  @@map("publicacoes")
}

model Curtida {
  id String @id @default(uuid())

  usuarioId String
  publicacaoId String

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  publicacao Publicacao @relation(fields: [publicacaoId], references: [id])

  @@unique([usuarioId, publicacaoId])

  @@map("curtidas")
}

enum TipoPublicacao {
  COMUM
  PERDIDO
  ADOCAO
}