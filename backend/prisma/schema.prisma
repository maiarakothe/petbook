generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


// Depois de você fazer qualquer alteração nesse arquivo executa: npx prisma migrate dev
//e: npx prisma generate

model Usuario {

  id String @id @default(uuid())
  nome String
  email String @unique
  senha String

  pets Pet[]
  publicacoes Publicacao[]
  curtidas Curtida[]
  comentarios Comentario[]

  @@map("usuarios")
}

model Pet {

  id String @id @default(uuid())
  nome String
  foto String
  raca String
  tipo_animal String
  idade String
  localizacao String

  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  publicacoes Publicacao[]

  @@map("pets")
}

model Publicacao {

  id String @id @default(uuid())
  foto String
  legenda String
  tipo TipoPublicacao

  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  petId String
  pet Pet @relation(fields: [petId], references: [id])

  curtidas Curtida[]
  comentarios Comentario[]

  @@map("publicacoes")
}

model Curtida {
  id String @id @default(uuid())

  usuarioId String
  publicacaoId String

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  publicacao Publicacao @relation(fields: [publicacaoId], references: [id])

  @@unique([usuarioId, publicacaoId])

  @@map("curtidas")
}

model Comentario {
  id String @id @default(uuid())
  texto String
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  publicacaoId String
  publicacao Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)

  @@index([publicacaoId, criadoEm])
  @@map("comentarios")
}

enum TipoPublicacao {
  COMUM
  PERDIDO
  ADOCAO
}